<Window x:Class="MoonStrap.BootstrapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoonStrap" Width="460" Height="230" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Icon="Assets/moon.ico"
        WindowStartupLocation="CenterScreen" Topmost="True" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="18" Background="{StaticResource SpaceBg}" BorderBrush="#40A99CFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <!-- moonlight glow -->
            <Ellipse Width="260" Height="260" HorizontalAlignment="Left" Margin="-90,-90,0,0" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#447C6CFF" Offset="0"/>
                        <GradientStop Color="#007C6CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas x:Name="Stars" IsHitTestVisible="False"/>

            <Grid Margin="26,24,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image x:Name="Moon" Source="Assets/moon.png" Width="52" Height="52"
                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform><ScaleTransform x:Name="Pulse"/></Image.RenderTransform>
                    </Image>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Header" Text="MoonStrap" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Status" Text="Starting..." Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    </StackPanel>
                </StackPanel>

                <!-- progress -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                    <Border x:Name="Track" Height="6" CornerRadius="3" Background="#1FFFFFFF" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource AccentGrad}"/>
                            <Border x:Name="Shimmer" HorizontalAlignment="Left" Width="110" CornerRadius="3" Background="{StaticResource AccentGrad}">
                                <Border.RenderTransform><TranslateTransform x:Name="ShimmerX"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Right" Content="Cancel" Padding="14,5" Margin="0" Click="Cancel_Click"/>
                    <TextBlock x:Name="Percent" Foreground="{StaticResource MoonGold}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
