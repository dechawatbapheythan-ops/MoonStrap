<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MoonStrap</AssemblyName>
    <RootNamespace>MoonStrap</RootNamespace>
    <Product>MoonStrap</Product>
    <AssemblyTitle>MoonStrap</AssemblyTitle>
    <Description>MoonStrap - Roblox launcher</Description>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\moon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\moon.png" />
    <Resource Include="Assets\moon-art.png" />
    <Resource Include="Assets\moon.ico" />
  </ItemGroup>
</Project>



